# Copy to .env.local and fill in. Without the Supabase values the site runs in
# demo mode (sample content, no sign-in).

# --- Supabase (Project Settings -> API). Use the publishable key, or the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # accepted instead of the publishable key

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# IANA timezone every visitor sees event times in
NEXT_PUBLIC_CLUB_TIMEZONE=Asia/Kolkata

# --- AI assistant (server-only; never prefix with NEXT_PUBLIC_)
# Create a key at https://aistudio.google.com/apikey . Without it the assistant
# answers from the built-in club FAQ ("offline mode").
GEMINI_API_KEY=
# gemini-1.5-flash has been shut down by Google (requests return 404); use a current model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: send Gemini traffic through a proxy / API gateway
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
